{
    "name": "daniel-km/omeka-s-module-reference",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Add glossary pages and blocks with the alphabetical indexes of specified classes and properties.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "glossary",
        "indexing",
        "lexicon"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-Reference",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-Reference/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.1",
        "daniel-km/omeka-s-module-common": "*"
    },
    "require": {
        "sempia/external-assets": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Reference\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReferenceTest\\": "tests/ReferenceTest/"
        }
    },
    "config": {
        "allow-plugins": {
            "sempia/external-assets": true
        }
    },
    "extra": {
        "installer-name": "Reference",
        "external-assets": {
            "asset/vendor/jquery-simplefolders/main.css": "https://raw.githubusercontent.com/collinsp/jquery-simplefolders/86a73c589a199a20fbf082bb03867a75d2ab00af/jquery-simplefolders/main.css",
            "asset/vendor/jquery-simplefolders/main.js": "https://raw.githubusercontent.com/collinsp/jquery-simplefolders/86a73c589a199a20fbf082bb03867a75d2ab00af/jquery-simplefolders/main.js",
            "asset/vendor/jquery-simplefolders/icons.png": "https://raw.githubusercontent.com/collinsp/jquery-simplefolders/86a73c589a199a20fbf082bb03867a75d2ab00af/jquery-simplefolders/icons.png"
        }
    }
}
